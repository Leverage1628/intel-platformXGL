       var rows=srt.slice(0,8).map(function(x){return '<div class="conc-r"><span class="conc-d">'+x[0]+'</span><span class="conc-n">'+x[1]+' \u00b7 '+Math.round(x[1]/tot*100)+'%</span></div>'}).join('');
       return '<b>'+tot+' specific citations across '+srt.length+' distinct domains. The three most-used account for '+top3+' \u2014 '+Math.round(top3/tot*100)+'% of the total.</b><br><br>'
