function renderKV(arr,defs){
  var groups={},order=[];
  arr.forEach(function(x){ if(!groups[x.k]){groups[x.k]=[];order.push(x.k);} groups[x.k].push(x); });
  return defs+order.map(function(k){
    return '<div class="mv-sec">'+k+' \u00b7 '+groups[k].length+'</div>'
      +groups[k].map(function(x){
        var links=(x.t||[]).map(function(id){var d=DB.find(function(y){return y.id===id});
          return d?'<span class="kv-t" onclick="closeOverlay();pick(\''+id+'\')">'+d.name.split('\u2014')[0].trim()+'</span>':'';}).join('');
        return '<div class="kv-card"><div class="kv-h"><span class="kv-n">'+x.n+'</span><span class="kv-v">'+x.v+'</span></div>'
          +'<div class="kv-d">'+x.d+'</div>'
          +(links?'<div class="kv-ts">'+links+'</div>':'')+'</div>';
      }).join('');
  }).join('');
}
function openMIC(){
  var defs='<div class="intro-note" style="margin-bottom:14px">Who builds the weapons, who sells them, and who is constrained by production rather than by politics. <b>Arms manufacturing is the layer beneath every theater on this board</b> \u2014 and in 2026 it became a limiting factor rather than a background condition.</div>'
   +'<div class="dx-grid"><div class="dx-box"><div class="dx-t">HOW TO READ THIS BOARD</div>'
   +'<div class="dx-d"><b>ARMS TRANSFER</b> \u2014 SIPRI measures deliveries of major conventional weapons by <b>trend indicator value</b>, a volume measure of military capability transferred, <i>not</i> the price paid. It is designed to compare across decades and currencies, which is why the figures rarely match contract values reported in the press.</div>'
   +'<div class="dx-d"><b>ARMS REVENUE vs ARMS EXPORTS \u2014 two different things.</b> A company\u2019s arms revenue includes what it sells to its own government. A state\u2019s export share counts only what leaves the country. Russia in 2026 is the case that separates them: company revenue <b>up 23%</b> while export share <b>fell 64%</b>, because everything produced is being consumed at home.</div>'
   +'<div class="dx-d"><b>THE PRODUCTION CONSTRAINT</b> \u2014 modern munitions have multi-year lead times and narrow supplier bases for propellant, explosives and guidance electronics. Money does not convert into shells quickly. This is why stockpile depth, not defence budget, is the number that actually binds during a sustained campaign.</div>'
   +'<div class="dx-d"><b>OFFSETS and LOCAL CONTENT</b> \u2014 large arms deals typically require the seller to invest in or manufacture within the buyer\u2019s economy. This is how import dependence becomes industrial policy, and it is what India is converting into domestic production capacity.</div>'
   +'</div></div>';
  board('\u2699 MILITARY-INDUSTRIAL \u00b7 WHO BUILDS AND WHO SELLS', renderKV(MIC,defs));
}
function openPlumbing(){
  var defs='<div class="intro-note" style="margin-bottom:14px">The machinery that moves money and cargo when the formal system is closed. <b>The Debt board tracks who owes what. This one tracks how value actually travels</b> \u2014 the vessels, flags, insurers, traders, exchange houses and clearing channels that determine whether a sanction bites or merely reroutes.</div>'
   +'<div class="dx-grid"><div class="dx-box"><div class="dx-t">HOW THE PLUMBING WORKS</div>'
   +'<div class="dx-d"><b>CORRESPONDENT BANKING</b> \u2014 most banks hold no foreign currency directly; they hold accounts at banks that do. A dollar payment between two non-US banks clears through a US institution. That single fact gives Washington reach over transactions with no American party to them, and it is the mechanism secondary sanctions exploit.</div>'
   +'<div class="dx-d"><b>SWIFT</b> is messaging, not money \u2014 it carries payment instructions between banks. Being cut off does not freeze funds; it removes the standard way of telling anyone where to send them. That is why exclusion degrades trade rather than halting it, and why substitutes appear.</div>'
   +'<div class="dx-d"><b>FLAG OF CONVENIENCE</b> \u2014 a ship registers in a state with minimal oversight and no connection to its owner. The flag state is legally responsible for inspection and enforcement, which is exactly why registries with limited capacity are chosen.</div>'
   +'<div class="dx-d"><b>P&amp;I CLUB</b> \u2014 the mutual insurers covering third-party maritime liability. Losing Western P&amp;I cover is the practical constraint on a tanker calling at a regulated port, so the shadow fleet runs on non-Western or fabricated cover and accepts the ports that will take it.</div>'
   +'<div class="dx-d"><b>STS TRANSFER</b> \u2014 ship-to-ship cargo transfer at sea, which breaks the documentary chain between origin and delivery. Combined with AIS transponders switched off, it is how sanctioned crude acquires a clean paper origin.</div>'
   +'<div class="dx-d"><b>TRADE-BASED MONEY LAUNDERING</b> \u2014 moving value by mis-stating the price, quantity or nature of goods on an invoice. No cash needs to cross a border; the trade document does the work, which is why commodity trading is the natural habitat for it.</div>'
   +'</div></div>';
  board('\u25c8 FINANCIAL PLUMBING \u00b7 HOW VALUE ACTUALLY MOVES', renderKV(PLUMB,defs));
}


function openCorrections(){
  var rows=[];
  DB.forEach(function(d){
    (d.log||[]).forEach(function(l){
      if(/CORRECT|self-correct|reversed|overstated|stale|wrong|MAJOR UPDATE/i.test(l.c)) rows.push({id:d.id,name:d.name,d:l.d,c:l.c,esc:d.esc});
    });
  });
  rows.sort(function(a,b){return b.esc-a.esc});
  var cards=rows.map(function(r){
    return '<div class="corr-card" onclick="closeOverlay();pick(\''+r.id+'\')">'
      +'<div class="corr-h"><span class="corr-n">'+r.name.split('\u2014')[0].trim()+'</span><span class="corr-d">'+r.d+'</span></div>'
      +'<div class="corr-c">'+r.c+'</div></div>';
  }).join('');
  var noteCorr=DB.filter(function(d){return /CORRECTION|overstated|GOT WRONG|falsif|WAS OUT OF DATE/i.test(d.note||'')}).length;
  var scored=WATCH.filter(function(w){return w.verdict});
  var wrong=scored.filter(function(w){return /NOT TRIPPED|contrary signal|PREMISE CHANGED|cuts against|REVISED|CLOSED ON ITS DUE DATE/i.test(w.verdict)}).length;
  var intro='<div class="intro-note" style="margin-bottom:14px">Every change this platform has made to a claim it previously published, in one place. <b>'+rows.length+' logged corrections</b> across '+new Set(rows.map(function(r){return r.id})).size+' theaters, plus <b>'+noteCorr+' theaters</b> carrying a correction written into the field note itself. Of '+scored.length+' scored tripwires, <b>'+wrong+' record this board being wrong, contradicted, or having set the wrong question.</b></div>'
   +'<div class="dx-grid"><div class="dx-box"><div class="dx-t">WHY THIS BOARD EXISTS AND WHAT IT DOES NOT PROVE</div>'
   +'<div class="dx-d">Corrections used to be narrated inside each theater\u2019s field note, which meant the volume of self-auditing grew until it competed with the analysis for attention. <b>They are consolidated here so the record is auditable without the product talking about its own honesty on every card.</b></div>'
   +'<div class="dx-d"><b>What this record shows:</b> the mechanism works. Errors get found, logged in place rather than overwritten, and the original claim stays visible beside the correction.</div>'
   +'<div class="dx-d"><b>What it does not show:</b> that the mechanism catches everything. Every entry here was found by the same analyst who made the error. <b>A correction log with no external contributors is evidence of diligence, not of coverage</b> \u2014 and the errors that matter most are the ones nobody on the inside was positioned to notice.</div>'
   +'<div class="dx-d"><b>The pattern worth noting:</b> the largest corrections were not missed events but missed <i>changes of structure</i> \u2014 a peace framework that had collapsed, a war that had been formally declared, an alliance that had inverted. Routine sweeps hunt for events. Structural change is what they miss.</div>'
   +'</div></div>';
  board('\u21ba CORRECTIONS \u00b7 WHAT THIS BOARD GOT WRONG', intro+cards);
}


function openCorrections(){
  var rows=[];
  DB.forEach(function(d){
    (d.log||[]).forEach(function(l){
      if(/CORRECT|overstated|stale|wrong|reversed|MAJOR UPDATE/i.test(l.c))
        rows.push({t:d.name,id:d.id,d:l.d,c:l.c,esc:d.esc});
    });
  });
  rows.sort(function(a,b){return b.esc-a.esc});
  var cards=rows.map(function(r){
    return '<div class="corr-card" onclick="closeOverlay();pick(\''+r.id+'\')">'
      +'<div class="corr-h"><span class="corr-t">'+r.t+'</span><span class="corr-d">'+r.d+'</span></div>'
      +'<div class="corr-c">'+r.c+'</div></div>';
  }).join('');
  var wrongWires=(typeof WATCH!=='undefined')?WATCH.filter(function(w){return w.verdict&&/NOT TRIPPED|contrary signal|PREMISE CHANGED|cuts against|REVISED|scoring failure|noise|resupply interval/i.test(w.verdict)}):[];
  var wireCards=wrongWires.map(function(w){
    return '<div class="corr-card corr-wire"><div class="corr-h"><span class="corr-t">Tripwire \u00b7 '+w.ind+'</span><span class="corr-d">'+(w.due||w.hz||'')+'</span></div>'
      +'<div class="corr-c">'+String(w.verdict).slice(0,400)+'\u2026</div></div>';
  }).join('');
  var intro='<div class="intro-note" style="margin-bottom:14px">Every place this board has been wrong and said so, in one view. '
    +'<b>These are not caveats \u2014 they are specific claims this platform published and then had to withdraw or reverse.</b> '
    +'They are collected here rather than left scattered across theater cards, so the record can be read as a record.<br><br>'
    +'<b>'+rows.length+' logged corrections to theater files \u00b7 '+wrongWires.length+' tripwire verdicts recording a wrong or contradicted read.</b><br><br>'
    +'The pattern worth noticing: <b>most were structural changes rather than missed events.</b> Routine sweeps hunt for what happened; '
    +'they do not ask whether a framework has quietly collapsed. Ethiopia\u2019s peace agreement was dead for two months, Pakistan had declared '
    +'open war five months earlier, and Colombia had elected a president committed to ending its peace policy \u2014 none of which surfaced in a headline sweep.</div>';
  board('\u21ba CORRECTIONS \u00b7 WHERE THIS BOARD WAS WRONG', intro
