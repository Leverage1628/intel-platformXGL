function gfilter(){
  var box=document.getElementById("gfq");
  var q=box?String(box.value||"").toLowerCase().trim():"";
  var f=window._gfTier||"all";
  var cards=document.querySelectorAll(".grp-card"); var shown=0;
  for(var i=0;i<cards.length;i++){
    var c=cards[i];
    var txt=(c.textContent||"").toLowerCase();
    var prov=c.getAttribute("data-prov")||"";
    var tier=c.getAttribute("data-tier")||"";
    var okQ=(!q)||txt.indexOf(q)>=0;
    var okF=(f==="all")||(tier===f)||(prov===f);
    var ok=okQ&&okF;
    c.style.display=ok?"":"none";
    if(ok) shown++;
  }
  var el=document.getElementById("gfcount");
  if(el) el.textContent=shown+" of "+cards.length+" actors shown";
  var gs=document.querySelectorAll(".ov-group");
  for(var k=0;k<gs.length;k++){
    var g=gs[k];
    if(!g.querySelector(".grp-card")) continue;
    var inner=g.querySelectorAll(".grp-card"); var vis=0;
    for(var m=0;m<inner.length;m++){ if(inner[m].style.display!=="none") vis++; }
    g.style.display = vis===0 ? "none" : "";
  }
}
