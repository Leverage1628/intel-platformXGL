  }).join('');
  const elRows=ELECTIONS.map(function(e){var d=DB.find(function(x){return x.id===e.t;});return '<div class="wt-row" onclick="closeOverlay();pick(\''+e.t+'\')"><div class="wt-top"><span class="wt-th">'+(d?d.flag:'')+' '+(d?d.name.split('—')[0].trim():e.t)+'</span><span class="wt-hz">'+e.hz+'</span></div><div class="wt-ind">'+e.ind+'</div><div class="wt-mean">'+e.note+'</div></div>';}).join('');
