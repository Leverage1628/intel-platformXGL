function twFor(tid){
  if(typeof WATCH==='undefined')return '';
  var ws=WATCH.filter(function(w){return w.t===tid});
  if(!ws.length)return '';
  var rows=ws.map(function(w){
    var scored=!!w.verdict;
    var vd=scored?String(w.verdict):'';
    var tag='UNSCORED';
    if(scored){
      var pats=[[/^TRIPPED|^IMMINENT/i,'TRIPPED'],[/^PARTIAL/i,'PARTIAL'],[/^STALLED/i,'STALLED'],[/^NOT TRIPPED|^NOT TAKEN|^NOT YET/i,'NOT TRIPPED'],[/^PREMISE/i,'PREMISE CHANGED']];
      tag='SCORED';
      for(var pi=0;pi<pats.length;pi++){ if(pats[pi][0].test(vd)){ tag=pats[pi][1]; break; } }
    }
    var cls=({'TRIPPED':'twb-trip','PARTIAL':'twb-part','NOT TRIPPED':'twb-not','STALLED':'twb-part','PREMISE CHANGED':'twb-not','SCORED':'twb-part','UNSCORED':'twb-uns'})[tag];
    return '<div class="twb-r"><span class="twb-st '+cls+'">'+tag+'</span><span class="twb-i">'+w.ind+'</span>'+(w.due?'<span class="twb-d">due '+w.due+'</span>':'')+'</div>';
  }).join('');
  return '<div class="twb"><div class="twb-h">\u25c9 LIVE TRIPWIRES ON THIS THEATER \u2014 '+ws.length+'</div>'
    +'<div class="twb-sub">Dated things to watch, carried from the Watchlist. A tripwire is an escalation driver with a deadline and a verdict \u2014 status shown is this platform\u2019s own grade.</div>'
    +rows+'</div>';
}

function openEscalation(){
  const withE=DB.filter(d=>d.escalation).sort((a,b)=>b.esc-a.esc);
  const tally={climbing:0,volatile:0,stalemate:0,descending:0};
  withE.forEach(d=>tally[d.escalation.dir]=(tally[d.escalation.dir]||0)+1);
  const dirLabel={climbing:'CLIMBING',volatile:'VOLATILE',stalemate:'STALEMATE',descending:'DESCENDING'};
  const bcolor={climbing:'red',volatile:'amber',stalemate:'cyan',descending:'grn'};
  const cards=withE.map(function(d){
    var e=d.escalation;
    var fwTags=(e.fw||[]).map(function(f){var F=FRAMEWORKS.find(function(x){return x.id===f});return '<span class="escb-fwt">'+(F?F.name:f)+'</span>';}).join('');
    return '<div class="escb-card" style="border-left-color:var(--'+(bcolor[e.dir]||'line')+')" onclick="closeOverlay();pick(\''+d.id+'\')">'
      +'<div class="escb-head"><span class="escb-name">'+d.name+'</span><span class="esc-dir esc-'+e.dir+'">'+dirLabel[e.dir]+'</span><span class="escb-esc">esc '+d.esc+' \u00b7 '+e.phase+'</span></div>'
      +'<div class="escb-rung">Current rung: '+e.rung+'</div>'
      +'<div class="escb-cols">'
      +'<div class="escb-col escb-up"><h5>\u25b2 WHAT PUSHES IT UP</h5><ul>'+e.up.map(function(x){return '<li>'+x+'</li>'}).join('')+'</ul></div>'
      +'<div class="escb-col escb-down"><h5>\u25bc WHAT COULD BEND IT DOWN</h5><ul>'+e.down.map(function(x){return '<li>'+x+'</li>'}).join('')+'</ul></div>'
      +'</div>'
      +twFor(d.id)+'<div class="escb-fw">'+fwTags+'</div>'
      +'</div>';
  }).join('');
  var legend='<div class="esc-legend">Each active conflict read against how escalation theorists would map its trajectory \u2014 the <b>rung</b> it sits on, the <b>drivers</b> pushing it up, and the <b>off-ramps</b> that could bend it down. Direction: '
    +'<span class="esc-dir esc-climbing">CLIMBING</span> '+tally.climbing+' \u00b7 '
    +'<span class="esc-dir esc-volatile">VOLATILE</span> '+tally.volatile+' \u00b7 '
    +'<span class="esc-dir esc-stalemate">STALEMATE</span> '+tally.stalemate+' \u00b7 '
    +'<span class="esc-dir esc-descending">DESCENDING</span> '+tally.descending
    +'. <b>Scores are bands, not measurements — a gap under five points carries no information.</b> Framework tags reference the Frameworks board. Tap any card for the full theater.</div>';
  board('\u25b3 ESCALATION \u00b7 TRAJECTORY & OFF-RAMPS', legend+cards);
}
function openFrameworks(){
